# Autenticación tenant compartida temporal (se separará en P0-TENANT-AUTH)
JWT_SECRET=

# Autenticación exclusiva de plataforma
# Use un secreto aleatorio de al menos 32 caracteres y distinto de JWT_SECRET.
PLATFORM_JWT_SECRET=
PLATFORM_JWT_ISSUER=jesha-platform
PLATFORM_JWT_AUDIENCE=jesha-platform-api
PLATFORM_JWT_TTL=15m
