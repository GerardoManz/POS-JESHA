# Autenticación exclusiva de tenants
# Use un secreto aleatorio de al menos 32 caracteres y distinto del secreto de plataforma.
TENANT_JWT_SECRET=
TENANT_JWT_ISSUER=jesha-tenant
TENANT_JWT_AUDIENCE=jesha-tenant-api
TENANT_JWT_TTL=8h

# Autenticación exclusiva de plataforma
# Use un secreto aleatorio de al menos 32 caracteres y distinto del secreto tenant.
PLATFORM_JWT_SECRET=
PLATFORM_JWT_ISSUER=jesha-platform
PLATFORM_JWT_AUDIENCE=jesha-platform-api
PLATFORM_JWT_TTL=15m
